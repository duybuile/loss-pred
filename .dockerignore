# Version control
.git/
.gitignore

# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Secrets — never bake into the image
.env
.env.*

# ChromaDB index — rebuilt at runtime; persisted via docker-compose volume
.chroma/

# Jupyter
notebooks/
.ipynb_checkpoints/

# Dev tooling
tests/
scripts/
docs/
.claude/
.worktrees/
.vscode/
.idea/
.python-version

# Logs
*.log
logs.log

# OS
.DS_Store

# Data — bind-mounted at runtime (see docker-compose.yml)
data/

# Model artifacts — bind-mounted at runtime (see docker-compose.yml)
# Remove the line below if you want artifacts baked into the image instead.
app/artifacts/
